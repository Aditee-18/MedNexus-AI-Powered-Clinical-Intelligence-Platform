# ============================================================
# MedNexus AI - Environment Configuration Example
# Copy this file to .env and provide your actual credentials.
# ============================================================

# Groq API Key for Clinical LLM Reasoning & Agentic Execution
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Atlas or Local MongoDB Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/mednexus_db?retryWrites=true&w=majority
# Alternatively:
# MONGO_DB=mongodb://localhost:27017/mednexus_db
